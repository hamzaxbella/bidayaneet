# Use an external PostgreSQL database for hosted / multi-process deployments.
# DATABASE_URL=postgresql://user:password@localhost:5432/bidayaneet
# APP_ORIGIN=https://your-domain.example
# Single-process local demo: PostgreSQL via PGlite, persisted in this directory.
PLATFORM_DATA_DIR=.data/postgres
# Explicit seed command; never auto-seeded. Choose a demo password, 12+ characters.
DEMO_PASSWORD=
